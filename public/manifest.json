{
  "manifest_version": 3,
  "name": "Strava Wind Overlay",
  "version": "0.1.0",
  "description": "Windy-style wind animation and a 6-day forecast timeline on Strava maps, so you can plan rides with the wind.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.strava.com/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

{
  "name": "strava-wind-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "check": "biome check --write . && tsc --noEmit",
    "package": "npm run build && rm -f strava-wind-overlay-*.zip && cd dist && zip -qr ../strava-wind-overlay-$npm_package_version.zip ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/chrome": "^0.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
